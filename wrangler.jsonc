{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "elias-arts",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/files/*"]
  },
  "analytics": { "binding": "ANALYTICS_SQL" },
  "analytics_engine_datasets": [
    { "binding": "ANALYTICS_ENGINE", "dataset": "elias_arts_analytics" }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "elias-arts-files"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "elias-arts-db",
      "database_id": "1cbd5c3c-84aa-4897-b220-a6d0a3a24462"
    }
  ]
}